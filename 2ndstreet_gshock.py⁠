import os
import json
import requests
from bs4 import BeautifulSoup

# セカストオンラインのG-SHOCK検索URL
TARGET_URL = "https://www.2ndstreet.jp/search?category=900018&keyword=G-SHOCK"

# 重複チェック用の記録ファイル名
SEEN_FILE = "seen_items_2ndstreet.json"

# Discord Webhook URL（GitHub Secretsから取得）
DISCORD_WEBHOOK_URL = os.environ.get("DISCORD_WEBHOOK_URL")

# 特典PDFに基づいた狙い目キーワード群
KEYWORDS = [
    "TWIN SENSOR", "TRIPLE SENSOR", "ALTI", "SENSOR",  # センサー付き
    "オレンジ", "ピンク", "ネイビー", "グリーン", "イエロー",  # クレイジーカラー
    "迷彩", "カモフラ", "マーブル", "グラデーション", "タイガー",  # 柄物
    "フロッグマン", "FROGMAN", "ライズマン", "ガルフマン", "ガルフマスター", "レンジマン",  # 左右非対称・人気シリーズ
    "GL-130", "DW-6700", "DW-6500", "DW-8201", "DW-9900", "GW-203"
]

def load_seen_items():
    if os.path.exists(SEEN_FILE):
        try:
            with open(SEEN_FILE, "r", encoding="utf-8") as f:
                return set(json.load(f))
        except Exception:
            return set()
    return set()

def save_seen_items(seen_items):
    with open(SEEN_FILE, "w", encoding="utf-8") as f:
        json.dump(list(seen_items), f, ensure_ascii=False, indent=2)

def send_discord_notification(title, price, item_url, image_url):
    if not DISCORD_WEBHOOK_URL:
        print("Webhook URLが設定されていません。")
        return

    payload = {
        "embeds": [
            {
                "title": f"【ヒット】{title}",
                "url": item_url,
                "color": 15258703,  # オレンジ系カラー
                "fields": [
                    {"name": "価格", "value": f"{price:,} 円", "inline": True}
                ],
                "thumbnail": {"url": image_url} if image_url else {}
            }
        ]
    }
    
    response = requests.post(DISCORD_WEBHOOK_URL, json=payload)
    if response.status_code != 204:
        print(f"Discord通知失敗: {response.status_code}, {response.text}")

def check_new_items():
    seen_items = load_seen_items()
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
    
    try:
        res = requests.get(TARGET_URL, headers=headers, timeout=15)
        res.raise_for_status()
    except Exception as e:
        print(f"取得エラー: {e}")
        return

    soup = BeautifulSoup(res.text, "html.parser")
    items = soup.select(".itemCard")
    
    new_found_count = 0

    for item in items:
        # 商品IDの取得
        item_id = item.get("data-item-id")
        if not item_id:
            link = item.select_one("a")
            if link and "href" in link.attrs:
                item_id = link["href"].split("/")[-1]

        if not item_id or item_id in seen_items:
            continue

        # タイトル取得
        title_elem = item.select_one(".itemTitle")
        title = title_elem.text.strip() if title_elem else ""

        # 価格取得
        price_elem = item.select_one(".itemPrice")
        if not price_elem:
            continue
        
        price_text = price_elem.text.strip()
        price_clean = "".join(filter(str.isdigit, price_text))
        if not price_clean:
            continue
        price = int(price_clean)

        # URL・画像取得
        link_elem = item.select_one("a")
        item_url = f"https://www.2ndstreet.jp{link_elem['href']}" if link_elem and link_elem.get("href") else TARGET_URL
        
        img_elem = item.select_one("img")
        image_url = img_elem.get("src") if img_elem else ""

        # 判定条件（8,000円以下 かつ キーワード一致）
        if price <= 8000 and any(kw.lower() in title.lower() for kw in KEYWORDS):
            print(f"新着ヒット: {title} ({price}円)")
            send_discord_notification(title, price, item_url, image_url)
            seen_items.add(item_id)
            new_found_count += 1

    if new_found_count > 0:
        save_seen_items(seen_items)

if __name__ == "__main__":
    check_new_items()
